    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "خط لولهٔ درخواست",
                      "items":  [
                                    "Gunicorn تنها نقطهٔ ورود WSGI است و Procfile سه ورکر تعریف می‌کند",
                                    "۹ لایهٔ میدل‌ور CSRF، کوکی امن و تشخیص پروکسی HTTPS را اعمال می‌کنند",
                                    "config/urls.py تنها نقطهٔ پخش به پنج اپ و به /admin/ است"
                                ]
                  },
                  {
                      "dot":  "emerald",
                      "title":  "پنج اپ، یک دیتابیس",
                      "items":  [
                                    "core خانه و ابزار مشترک، accounts احراز هویت، skills فهرست و پیشنهاد، exchanges چرخهٔ تبادل، dashboard پنل مدیر",
                                    "همهٔ اپ‌ها از یک Django ORM و یک PostgreSQL 17 مشترک استفاده می‌کنند",
                                    "AUTH_USER_MODEL روی accounts.User سفارشی است و PAGINATE_BY برابر ۱۲"
                                ]
                  },
                  {
                      "dot":  "amber",
                      "title":  "ارائه و فایل‌ها",
                      "items":  [
                                    "هر ویو با render پایان می‌یابد و قالب‌ها از templates/ و ظاهر از static/css/main.css می‌آید",
                                    "WhiteNoise فایل‌های ثابت را بدون Nginx سرو می‌کند",
                                    "آواتارها فقط در media/avatars و از مسیر Profile.avatar می‌روند"
                                ]
                  },
                  {
                      "dot":  "rose",
                      "title":  "کنترل دسترسی",
                      "items":  [
                                    "دسترسی در سه لایه است: login_required، admin_required و بررسی مالکیت در ویو",
                                    "کل پنل manage-panel پشت admin_required و بررسی is_staff قرار دارد",
                                    "X_FRAME_OPTIONS=DENY و escape قالب‌ها مرز امنیتی رندر هستند"
                                ]
                  }
              ]
